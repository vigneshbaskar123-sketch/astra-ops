# Copy this file to backend/.env and fill in real values before deploying.
# Nothing in this repo hardcodes secrets — see app/core/config.py for how
# each of these is consumed.

# --- General ---
ENVIRONMENT=development

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# There is NO safe default for this in production — the app falls back to
# an obviously-fake dev key only so tests/scripts run without a .env.
SECRET_KEY=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ---
# Local dev default (SQLite, no server needed):
DATABASE_URL=sqlite:///./astra_ops.db
# docker-compose overrides this to Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg2://astra:astra@postgres:5432/astra_ops

# --- CORS (JSON array of allowed frontend origins) ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- File uploads ---
MAX_UPLOAD_SIZE_MB=200

# --- Default observatory (used until real Observatory rows exist) ---
DEFAULT_OBSERVATORY_NAME=Vainu Bappu Observatory (demo)
DEFAULT_LATITUDE_DEG=12.5748
DEFAULT_LONGITUDE_DEG=78.8205
DEFAULT_ELEVATION_M=725.0
DEFAULT_TIMEZONE=Asia/Kolkata

# --- AI Assistant (wired up in a later stage) ---
# Get a key at https://console.anthropic.com/ — leave blank to disable
# the assistant; every other module works without it.
ANTHROPIC_API_KEY=
AI_ASSISTANT_MODEL=claude-sonnet-4-6

# --- Simulators (never real hardware/sensors unless you build and wire
# a real adapter — see services/telescope_interface.py and
# services/weather_simulator.py) ---
TELESCOPE_SLEW_RATE_DEG_PER_SEC=3.0
WEATHER_UPDATE_INTERVAL_SEC=60
